{
  "Logging": {
    "Policy": {
      "EnableRequestBodyLogging": true,
      "EnableResponseBodyLogging": true,
      "BodyAllowlistPathPrefixes": [ "/api" ],
      "MaxRequestBodyLogSizeBytes": 65536,
      "MaxResponseBodyLogSizeBytes": 65536,
      "MaxLoggedBodyPreviewLength": 8192
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] [{MobileId}] {RequestMethod} {RequestPath} => {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "path": "logs/app-log-.txt",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 7,
          "shared": true
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "DynamicLogPoc [Dev]"
    }
  },
  "AppSettings": {
    "ApplicationName": "DynamicLogPoc [Dev]"
  }
}
